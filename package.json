{
  "name": "n8n-nodes-qireader",
  "version": "0.1.0",
  "description": "Manage QiReader feeds and articles in n8n",
  "license": "MIT",
  "author": {
    "name": "ZHA30",
    "email": "115915443+ZHA30@users.noreply.github.com"
  },
  "keywords": [
    "n8n-community-node-package",
    "qireader"
  ],
  "homepage": "https://github.com/ZHA30/n8n-nodes-qireader#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/ZHA30/n8n-nodes-qireader.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "n8n-node build",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "test": "npm run build && node --test tests/*.test.cjs"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": false,
    "credentials": [
      "dist/credentials/QiReaderApi.credentials.js",
      "dist/credentials/QiReaderCookieApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/QiReader/QiReader.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.57.3",
    "@types/node": "22.20.5",
    "n8n-workflow": "2.47.0",
    "typescript": "5.9.3"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
